<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Version>1.3.4</Version>
    <RootNamespace>SonarController</RootNamespace>
    <AssemblyName>SonarController</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SonarController-App.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <SelfContained>true</SelfContained>
    <!-- 常駐メモリ削減: バックグラウンドGCスレッドと動的PGOの計測バッファを使わない -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WPFではProgram.csを持たないため、DPI設定はapp.manifestで行う -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Full/TrialはEXE配布用。TrialTest/Store/StoreDevはテスト用。StoreDev/TrialTestはDebug限定。 -->
  <PropertyGroup>
    <LicenseEdition Condition="'$(LicenseEdition)' == ''">Full</LicenseEdition>
    <DefineConstants Condition="'$(LicenseEdition)' == 'Trial'">$(DefineConstants);LICENSE_TRIAL</DefineConstants>
    <DefineConstants Condition="'$(LicenseEdition)' == 'TrialTest'">$(DefineConstants);LICENSE_TRIAL_TEST</DefineConstants>
    <DefineConstants Condition="'$(LicenseEdition)' == 'Store'">$(DefineConstants);LICENSE_STORE</DefineConstants>
    <DefineConstants Condition="'$(LicenseEdition)' == 'StoreDev'">$(DefineConstants);LICENSE_STORE_DEV</DefineConstants>
    <TrialTestDays Condition="'$(LicenseEdition)' == 'TrialTest' and '$(TrialTestDays)' == ''">1</TrialTestDays>
  </PropertyGroup>

  <Target Name="ValidateLicenseEdition" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(LicenseEdition)' != 'Full' and '$(LicenseEdition)' != 'Trial' and '$(LicenseEdition)' != 'TrialTest' and '$(LicenseEdition)' != 'Store' and '$(LicenseEdition)' != 'StoreDev'"
           Text="LicenseEdition must be Full, Trial, TrialTest, Store, or StoreDev." />
    <Error Condition="'$(LicenseEdition)' == 'StoreDev' and '$(Configuration)' != 'Debug'"
           Text="StoreDev license mode is development-only and can only be built with Configuration=Debug." />
    <Error Condition="'$(LicenseEdition)' == 'TrialTest' and '$(Configuration)' != 'Debug'"
           Text="TrialTest is development-only and can only be built with Configuration=Debug." />
    <Error Condition="'$(LicenseEdition)' == 'TrialTest' and '$(TrialTestDays)' != '1' and '$(TrialTestDays)' != '2' and '$(TrialTestDays)' != '3' and '$(TrialTestDays)' != '4' and '$(TrialTestDays)' != '5' and '$(TrialTestDays)' != '6' and '$(TrialTestDays)' != '7' and '$(TrialTestDays)' != '8' and '$(TrialTestDays)' != '9' and '$(TrialTestDays)' != '10' and '$(TrialTestDays)' != '11' and '$(TrialTestDays)' != '12' and '$(TrialTestDays)' != '13' and '$(TrialTestDays)' != '14'"
           Text="TrialTestDays must be an integer from 1 through 14." />
  </Target>

  <Target Name="GenerateTrialTestSettings" BeforeTargets="CoreCompile" Condition="'$(LicenseEdition)' == 'TrialTest'">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)TrialTestSettings.g.cs"
      Lines="namespace SonarController.Services.License%3B internal static class TrialTestSettings { public const int TrialDays = $(TrialTestDays)%3B }"
      Overwrite="true" />
  </Target>

  <ItemGroup>
    <!-- Trial license data protection -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- MVVM toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- Tray icon support -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <!-- Windows audio endpoint volume control -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SonarController.Tests" />
    <Compile Include="$(IntermediateOutputPath)TrialTestSettings.g.cs" Condition="'$(LicenseEdition)' == 'TrialTest'" />
    <!-- テスト・パッケージング用ファイルはアプリ本体に含めない -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <Compile Remove="packaging\**" />
    <None Remove="packaging\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SonarController-App.ico" />
    <Resource Include="Assets\SonarController-Tray.ico" />
  </ItemGroup>

</Project>
