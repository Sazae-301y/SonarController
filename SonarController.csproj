<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Version>1.3.0</Version>
    <RootNamespace>SonarController</RootNamespace>
    <AssemblyName>SonarController</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SonarController-App.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <!-- Cursor.Position / Screen.WorkingArea をトレイポップアップの位置決めに使用 -->
    <UseWindowsForms>true</UseWindowsForms>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WPFではProgram.csを持たないため、DPI設定はapp.manifestで行う -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Full/TrialはEXE配布用。StoreはMSIXのパッケージIDがある環境専用。 -->
  <PropertyGroup>
    <LicenseEdition Condition="'$(LicenseEdition)' == ''">Full</LicenseEdition>
    <DefineConstants Condition="'$(LicenseEdition)' == 'Trial'">$(DefineConstants);LICENSE_TRIAL</DefineConstants>
    <DefineConstants Condition="'$(LicenseEdition)' == 'Store'">$(DefineConstants);LICENSE_STORE</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateLicenseEdition" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(LicenseEdition)' != 'Full' and '$(LicenseEdition)' != 'Trial' and '$(LicenseEdition)' != 'Store'"
           Text="LicenseEdition must be Full, Trial, or Store." />
  </Target>

  <ItemGroup>
    <!-- Trial license data protection -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- MVVM toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- Tray icon support -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <!-- Windows audio endpoint volume control -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SonarController.Tests" />
    <!-- テスト・パッケージング用ファイルはアプリ本体に含めない -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <Compile Remove="packaging\**" />
    <None Remove="packaging\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SonarController-App.ico" />
    <Resource Include="Assets\SonarController-Tray.ico" />
  </ItemGroup>

</Project>
