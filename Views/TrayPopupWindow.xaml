<Window x:Class="SonarController.Views.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:SonarController.Helpers"
        Title="SonarController"
        Icon="pack://application:,,,/Assets/SonarController.ico"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-10000" Top="-10000"
        Opacity="0"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <helpers:PercentConverter x:Key="PercentConverter"/>
        <helpers:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <helpers:HexToBrushConverter x:Key="HexToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F0F0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="Padding" Value="8,4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AudioDeviceItemStyle" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#33313F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#403A59"/>
                                <Setter Property="Foreground" Value="#C5B8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="Padding" Value="12,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#22212B"/>
            <Setter Property="BorderBrush" Value="#514D63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AudioDeviceItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Frame" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="10">
                                            <Path Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0" Stroke="#B9B4C8" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="#9180D2"/>
                                                <Setter TargetName="Frame" Property="Background" Value="#292735"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="#9B86F5"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,38,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" VerticalOffset="4">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280" Background="#201F28" BorderBrush="#514D63"
                                        BorderThickness="1" CornerRadius="10" Padding="5">
                                    <ScrollViewer CanContentScroll="False" MaxHeight="270"
                                                  PanningMode="VerticalOnly" PanningDeceleration="0.001"
                                                  PanningRatio="1" IsDeferredScrollingEnabled="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FF6B6B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="FontSize" Value="16"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChannelColumn" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="Width" Value="116"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Colorful vertical slider (filled track below thumb, dim track above) -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ThumbEllipse" Width="20" Height="20"
                                 Fill="White" Stroke="#40000000" StrokeThickness="1"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter TargetName="ThumbEllipse" Property="Width" Value="32"/>
                                <Setter TargetName="ThumbEllipse" Property="Height" Value="32"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderFilledTrackStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Width="12" CornerRadius="6" HorizontalAlignment="Center"
                                Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource HexToBrush}}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmptyTrackStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Width="12" CornerRadius="6" Background="#33FFFFFF" HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorfulVerticalSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Width="24">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFilledTrackStyle}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmptyTrackStyle}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Style="{StaticResource SliderThumbStyle}" Height="20" Width="24"/>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter TargetName="PART_Track" Property="Width" Value="40"/>
                                <Setter TargetName="PART_Thumb" Property="Height" Value="32"/>
                                <Setter TargetName="PART_Thumb" Property="Width" Value="40"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Height" Value="190"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Horizontal variant of the colorful slider (device mix volume) -->
        <Style x:Key="SliderFilledHorizontalTrackStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="12" CornerRadius="6" VerticalAlignment="Center"
                                Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource HexToBrush}}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmptyHorizontalTrackStyle" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="12" CornerRadius="6" Background="#33FFFFFF" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EndpointVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Tag" Value="#7C4DFF"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="24">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFilledHorizontalTrackStyle}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmptyHorizontalTrackStyle}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Style="{StaticResource SliderThumbStyle}" Height="24" Width="20"/>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter TargetName="PART_Track" Property="Height" Value="40"/>
                                <Setter TargetName="PART_Thumb" Property="Height" Value="40"/>
                                <Setter TargetName="PART_Thumb" Property="Width" Value="32"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Height" Value="44"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Round toggle buttons (routing / mute) -->
        <Style x:Key="RoutingToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="14" Background="#33FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource HexToBrush}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Width" Value="44"/>
                    <Setter Property="Height" Value="44"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MuteToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource RoutingToggleStyle}">
            <Setter Property="Tag" Value="#E53935"/>
        </Style>

        <!-- Header pill buttons: shared look for toggles (Audience / Streamer / Pin) and plain buttons (Settings) -->
        <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Tag" Value="#00BFA5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bg" CornerRadius="12" Background="#26FFFFFF"
                                    BorderBrush="#26FFFFFF" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Overlay" CornerRadius="12" Background="#1FFFFFFF"
                                    Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#33000000"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}"/>
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexToBrush}}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="Padding" Value="14,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource PillToggleStyle}">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Tag" Value="#7C4DFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="Padding" Value="8,8"/>
                    <Setter Property="FontSize" Value="16"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bg" CornerRadius="12" Background="#26FFFFFF"
                                    BorderBrush="#26FFFFFF" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Overlay" CornerRadius="12" Background="#1FFFFFFF"
                                    Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#33000000"/>
                                <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InteractionMode.IsTouchOptimized, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="MinWidth" Value="44"/>
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="Padding" Value="8,8"/>
                    <Setter Property="FontSize" Value="16"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

        <Border Margin="16"
            Background="#CC181822"
            CornerRadius="18"
            BorderBrush="#26FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="#FF6B6B" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}"
                       Margin="0,0,0,12" MaxWidth="760"/>

            <!-- Device mix controls (left) and window buttons (right) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding DeviceMixes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="#D7DCE2"/>
                                <Grid Grid.Column="1">
                                    <Grid.RenderTransform>
                                        <TranslateTransform X="-14"/>
                                    </Grid.RenderTransform>
                                    <ComboBox ItemsSource="{Binding Devices}"
                                              SelectedItem="{Binding SelectedDevice}"
                                              DisplayMemberPath="FriendlyName"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                    <TextBlock Text="未接続" Foreground="#FF6B6B"
                                               Margin="12,0,38,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Slider Grid.Column="2" Minimum="0" Maximum="1" SmallChange="0.01"
                                        IsMoveToPointEnabled="True" Style="{StaticResource EndpointVolumeSliderStyle}"
                                        Value="{Binding Volume}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Volume, Converter={StaticResource PercentConverter}}"
                                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="#D7DCE2"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ToggleButton Content="👥 Audience" Margin="0,0,0,8"
                                  Style="{StaticResource PillToggleStyle}"
                                  Visibility="{Binding IsStreamerMode, Converter={StaticResource BoolToVis}}"
                                  IsChecked="{Binding AudienceMonitoring}"/>
                    <ToggleButton Content="📡 Streamer" Margin="0,0,0,8"
                                  Style="{StaticResource PillToggleStyle}"
                                  IsChecked="{Binding IsStreamerMode}"/>
                    <UniformGrid Rows="1">
                        <ToggleButton x:Name="PinToggle" Content="📌" Margin="0,0,4,0"
                                      Style="{StaticResource PillIconToggleStyle}"
                                      ToolTip="ウィンドウを固定（外をクリックしても閉じない）"/>
                        <Button Content="⚙" Margin="4,0,0,0" Style="{StaticResource PillButtonStyle}"
                                Click="SettingsButton_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- Channel mixer -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Channels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ChannelColumn}"
                                Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}"
                                BorderBrush="{Binding AccentColor, Converter={StaticResource HexToBrush}}"
                                Opacity="0.96">
                            <Border Background="#CC181822" CornerRadius="8" Margin="-10" Padding="10">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,12" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding AccentColor, Converter={StaticResource HexToBrush}}">
                                        <Run Text="{Binding Icon, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Streamer: routing toggles (personal / stream) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12"
                                                Visibility="{Binding HasRouting, Converter={StaticResource BoolToVis}}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStreamerMode}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ToggleButton Style="{StaticResource RoutingToggleStyle}" Content="🎧" ToolTip="Personalミックスへルーティング"
                                                      Tag="{Binding AccentColor}" IsChecked="{Binding PersonalRouted}"/>
                                        <ToggleButton Style="{StaticResource RoutingToggleStyle}" Content="📡" ToolTip="Streamミックスへルーティング"
                                                      Tag="{Binding AccentColor}" Margin="10,0,0,0" IsChecked="{Binding StreamRouted}"/>
                                    </StackPanel>

                                    <!-- Classic: single vertical slider + mute -->
                                    <StackPanel HorizontalAlignment="Center"
                                                Visibility="{Binding IsStreamerMode, Converter={StaticResource InverseBoolToVis}}">
                                        <Slider Style="{StaticResource ColorfulVerticalSlider}"
                                                Minimum="0" Maximum="1" SmallChange="0.01"
                                                IsMoveToPointEnabled="True" Tag="{Binding AccentColor}"
                                                Value="{Binding ClassicVolume}"/>
                                        <TextBlock Text="{Binding ClassicVolume, Converter={StaticResource PercentConverter}}"
                                                   FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                                        <ToggleButton Style="{StaticResource MuteToggleStyle}" Content="🔇" ToolTip="Mute"
                                                      HorizontalAlignment="Center" IsChecked="{Binding ClassicMuted}"/>
                                    </StackPanel>

                                    <!-- Streamer: Personal/Stream vertical sliders side by side -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Visibility="{Binding IsStreamerMode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Slider Style="{StaticResource ColorfulVerticalSlider}"
                                                    Minimum="0" Maximum="1" SmallChange="0.01"
                                                    IsMoveToPointEnabled="True" Tag="{Binding AccentColor}"
                                                    Value="{Binding PersonalVolume}"/>
                                            <TextBlock Text="{Binding PersonalVolume, Converter={StaticResource PercentConverter}}"
                                                       FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                                            <ToggleButton Style="{StaticResource MuteToggleStyle}" Content="🔇" ToolTip="Personal Mute"
                                                          HorizontalAlignment="Center" IsChecked="{Binding PersonalMuted}"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Margin="12,0,0,0">
                                            <Slider Style="{StaticResource ColorfulVerticalSlider}"
                                                    Minimum="0" Maximum="1" SmallChange="0.01"
                                                    IsMoveToPointEnabled="True" Tag="{Binding AccentColor}"
                                                    Value="{Binding StreamVolume}"/>
                                            <TextBlock Text="{Binding StreamVolume, Converter={StaticResource PercentConverter}}"
                                                       FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,8"/>
                                            <ToggleButton Style="{StaticResource MuteToggleStyle}" Content="🔇" ToolTip="Stream Mute"
                                                          HorizontalAlignment="Center" IsChecked="{Binding StreamMuted}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <ComboBox ItemsSource="{Binding EqConfigs}" SelectedItem="{Binding SelectedEqConfig}"
                                              DisplayMemberPath="Name" Margin="0,12,0,0"
                                              Visibility="{Binding HasEq, Converter={StaticResource BoolToVis}}"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
