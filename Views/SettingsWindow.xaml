<Window x:Class="SonarController2.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SonarController2 - 設定"
        Icon="pack://application:,,,/Assets/SonarController2.ico"
        Width="500" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
        <StackPanel>
            <TextBlock Text="一般" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <CheckBox Content="Windows起動時に自動起動する" IsChecked="{Binding IsAutoStartEnabled}" Margin="0,0,0,16"/>

            <TextBlock Text="操作モード" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <CheckBox Content="タッチ最適化モードを有効にする"
                      IsChecked="{Binding InteractionMode.IsTouchOptimized}" Margin="0,0,0,4"/>
            <TextBlock Text="オフにすると、マウス操作向けのコンパクトな表示になります。"
                       Foreground="Gray" TextWrapping="Wrap" Margin="8,0,0,4"/>
            <TextBlock Text="{Binding InteractionMode.Status}" Foreground="Gray"
                       TextWrapping="Wrap" Margin="8,0,0,16"/>

            <TextBlock Text="優先して表示するディスプレイ" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding DisplayOptions}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedDisplay}"
                      Margin="0,0,0,4"/>
            <TextBlock Text="{Binding DisplayStatus}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="バージョン情報" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding AppVersion, StringFormat='SonarController2 v{0}'}" Margin="0,0,0,16"/>

            <TextBlock Text="ホットキー設定" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,8">
                <Button Content="変更" Click="ChangeHotkey_Click" Padding="12,4" DockPanel.Dock="Right"/>
                <TextBlock Text="{Binding HotkeyDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock Text="{Binding HotkeyStatus}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="オーディオデバイス" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Devices.ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
            <TextBlock Text="出力デバイス" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <ItemsControl ItemsSource="{Binding Devices.OutputDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FriendlyName}" Margin="8,2,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="入力デバイス" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <ItemsControl ItemsSource="{Binding Devices.InputDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FriendlyName}" Margin="8,2,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
