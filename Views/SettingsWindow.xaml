<Window x:Class="SonarController.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}"
        Icon="pack://application:,,,/Assets/SonarController-App.ico"
        Width="680" Height="780" MinHeight="620" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="#F3F5F9"
        FontFamily="Segoe UI"
        FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#E7EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#20283A"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderBrush" Value="#D8DDE7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#20283A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6750C8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Foreground" Value="#263148"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#596276"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlBackground" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBackground" Property="Background" Value="#EEF0F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ControlBackground" Property="Background" Value="#E2E5EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseWindowButtonStyle" TargetType="Button"
               BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Foreground" Value="#596276"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlBackground" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBackground" Property="Background" Value="#D94B55"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ControlBackground" Property="Background" Value="#B93843"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,12"
                Background="White"
                BorderBrush="#E7EAF0" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" Background="#6750C8"
                            VerticalAlignment="Center">
                        <TextBlock Text="S" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="SonarController" FontSize="13" FontWeight="Bold"
                                   Foreground="#28233C"/>
                        <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="11"
                                   Foreground="#7C8495" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" Background="#F3F1FA" CornerRadius="8"
                        Padding="10,6" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}"
                               Foreground="#5B4AA0" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource WindowControlButtonStyle}"
                        Content="—" ToolTip="{DynamicResource Minimize}"
                        AutomationProperties.Name="{DynamicResource Minimize}"
                        Click="MinimizeButton_Click"/>
                <Button Grid.Column="3" Style="{StaticResource CloseWindowButtonStyle}"
                        Content="×" ToolTip="{DynamicResource Close}"
                        AutomationProperties.Name="{DynamicResource Close}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      x:Name="SettingsScrollViewer"
                      Padding="22,18" CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Language}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource LanguageDescription}" Foreground="#758096"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ComboBox ItemsSource="{Binding LanguageOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding LanguageStatus}" Foreground="#4A7C62"
                                       FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LicenseTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding LicenseStateText}" Foreground="#453B72"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LicenseDetailText}" Foreground="#758096"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource General}" Style="{StaticResource SectionTitleStyle}"/>
                        <CheckBox Content="{DynamicResource Startup}" IsChecked="{Binding IsAutoStartEnabled}"/>
                        <TextBlock Text="{Binding StartupStatus}" Foreground="#B3261E"
                                   FontSize="12" TextWrapping="Wrap" Margin="28,2,0,0"/>
                        <Separator Margin="0,8" Background="#EDF0F4"/>
                        <TextBlock Text="{DynamicResource Interaction}" FontWeight="SemiBold"
                                   Foreground="#263148" Margin="0,6,0,4"/>
                        <CheckBox Content="{DynamicResource TouchMode}"
                                  IsChecked="{Binding InteractionMode.IsTouchOptimized}"/>
                        <TextBlock Text="{DynamicResource TouchDescription}" Foreground="#758096"
                                   FontSize="12" TextWrapping="Wrap" Margin="28,0,0,4"/>
                        <TextBlock Text="{Binding InteractionMode.Status}" Foreground="#758096"
                                   FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Display}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource DisplayDescription}" Foreground="#758096"
                                   FontSize="12" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding DisplayOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedDisplay}"/>
                        <TextBlock Text="{Binding DisplayStatus}" Foreground="#758096"
                                   FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Hotkey}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                        <DockPanel LastChildFill="True">
                            <Button Content="{DynamicResource Change}" Click="ChangeHotkey_Click"
                                    DockPanel.Dock="Right" Margin="12,0,0,0"/>
                            <Border Background="#F5F3FC" CornerRadius="8" Padding="12,8"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding HotkeyDisplay}" Foreground="#453B72"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding HotkeyStatus}" Foreground="#758096"
                                   FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Devices}" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding Devices.ErrorMessage}" Foreground="#B54747"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Output}" FontWeight="SemiBold"
                                           Foreground="#536078" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Devices.OutputDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FriendlyName}" Foreground="#263148"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Input}" FontWeight="SemiBold"
                                           Foreground="#536078" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Devices.InputDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FriendlyName}" Foreground="#263148"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
