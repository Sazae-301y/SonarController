<Window x:Class="SonarController2.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SonarController2 - 設定"
        Width="420" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
        <StackPanel>
            <TextBlock Text="一般" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <CheckBox Content="Windows起動時に自動起動する" IsChecked="{Binding IsAutoStartEnabled}" Margin="0,0,0,16"/>

            <TextBlock Text="バージョン情報" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding AppVersion, StringFormat='SonarController2 v{0}'}" Margin="0,0,0,16"/>

            <TextBlock Text="ホットキー設定" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="（今後実装予定）" Foreground="Gray" Margin="0,0,0,16"/>

            <TextBlock Text="オーディオデバイス" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Devices.ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
            <TextBlock Text="出力デバイス" FontWeight="SemiBold" Margin="0,4,0,2"/>
            <ItemsControl ItemsSource="{Binding Devices.OutputDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FriendlyName}" Margin="8,0,0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="入力デバイス" FontWeight="SemiBold" Margin="0,8,0,2"/>
            <ItemsControl ItemsSource="{Binding Devices.InputDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FriendlyName}" Margin="8,0,0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
